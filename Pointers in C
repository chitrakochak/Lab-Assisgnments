#include <stdio.h>

// Function takes pointers to two integers so it can modify the original values
void swap(int *a, int *b) {
    int temp = *a; // Store the value at address 'a' in temp
    *a = *b;       // Copy the value at address 'b' into address 'a'
    *b = temp;     // Copy temp into address 'b'
}

int main() {
    int x, y;

    printf("Enter two numbers: ");
    scanf("%d %d", &x, &y);

    printf("Before swapping: x = %d, y = %d\n", x, y);

    // Pass the memory addresses of x and y using the address-of operator (&)
    swap(&x, &y);

    printf("After swapping:  x = %d, y = %d\n", x, y);

    return 0;
}
